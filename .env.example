# =============================================================================
# GTMFlow — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# All settings can also be set via system environment variables.
# =============================================================================


# ── LLM Providers ────────────────────────────────────────────────────────
# All provider credentials are listed here. LLM_PROVIDER below selects which
# one is active. Add new providers (OpenAI, etc.) as new sections.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxx
GOOGLE_MODEL=gemini-2.5-flash

# ── Active Provider ────────────────────────────────────────────────────────
# Set to "anthropic" or "google" to select which provider's key + model is used.
LLM_PROVIDER=anthropic


# ── Zoho CRM Webhook ────────────────────────────────────────────────────────
# Shared secret used to authenticate incoming Zoho webhook requests.
ZOHO_WEBHOOK_SECRET=your_webhook_secret

# OAuth credentials.
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token


# ── Database ────────────────────────────────────────────────────────────────
#   SQLite (dev):  sqlite:///./gtmflow.db
#   PostgreSQL:    postgresql://user:password@host:5432/gtmflow
DATABASE_URL=sqlite:///./gtmflow.db
REDIS_URL=redis://localhost:6379/0


# ── SMTP / Email ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=youremail@company.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=youremail@company.com

ALERT_RECIPIENT_EMAIL=sales@company.com
TEST_EMAIL=dev@company.com

REP_PREKSHA_EMAIL=preksha.r@company.com
REP_SRINI_EMAIL=srinivas.sharma@company.com
REP_ANUJA_EMAIL=anuja.thomas@company.com


# ── Environment Mode ────────────────────────────────────────────────────────
#   MODE=prod  → sends to ALERT_RECIPIENT_EMAIL
#   MODE=dev   → sends to TEST_EMAIL only
MODE=dev


# ── Error Tracking ──────────────────────────────────────────────────────────
SENTRY_DSN=
