ZOHO_WEBHOOK_SECRET=your_shared_secret_here
ANTHROPIC_API_KEY=your_anthropic_api_key
# SQLite for local dev; use a postgresql:// URL in production
DATABASE_URL=sqlite:///./gtmflow.db
# Redis backs the async job queue (RQ worker)
REDIS_URL=redis://localhost:6379/0
# SMTP — works with Gmail, Outlook, Office 365, Amazon SES, or any SMTP server
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=gtmflow@example.com
# Multiple recipients can be separated by commas
ALERT_RECIPIENT_EMAIL=sales-alerts@example.com
